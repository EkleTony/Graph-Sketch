    "import pandas as pd\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Load DARPA edges and ground truth labels\n",
    "edges_df = pd.read_csv(\"data/DARPA/darpa_edges.csv\", header=None, names=[\"src\", \"dst\", \"timestamp\"])\n",
    "labels_df = pd.read_csv(\"data/DARPA/darpa_ground_truth.csv\", header=None, names=[\"label\"])\n",
    "\n",
    "# Use only the first 10,000 edges for manageability\n",
    "edges_df = edges_df.head(10000)\n",
    "labels_df = labels_df.head(10000)\n",
    "edges_df[\"label\"] = labels_df[\"label\"]\n",
    "\n",
    "# Define 10 snapshot intervals from 100 to 10000\n",
    "snapshot_indices = [1000 * i for i in range(1, 11)]  # [1000, 2000, ..., 10000]\n",
    "\n",
    "# Set up plot\n",
    "fig, axes = plt.subplots(2, 5, figsize=(24, 10))\n",
    "axes = axes.flatten()\n",
    "\n",
    "for i, count in enumerate(snapshot_indices):\n",
    "    snapshot = edges_df.iloc[:count]\n",
    "    G = nx.DiGraph()\n",
    "    G.add_edges_from(snapshot[[\"src\", \"dst\"]].values)\n",
    "\n",
    "    # Use spring layout for consistent node positions\n",
    "    pos = nx.spring_layout(G, seed=42, k=0.25)\n",
    "\n",
    "    # Draw normal and anomalous edges\n",
    "    normal_edges = snapshot[snapshot[\"label\"] == 0]\n",
    "    anomalous_edges = snapshot[snapshot[\"label\"] == 1]\n",
    "\n",
    "    # Draw edges\n",
    "    nx.draw_networkx_edges(G, pos, ax=axes[i],\n",
    "                           edgelist=normal_edges[[\"src\", \"dst\"]].values,\n",
    "                           edge_color=\"lightblue\", alpha=0.6, width=0.8)\n",
    "    \n",
    "    nx.draw_networkx_edges(G, pos, ax=axes[i],\n",
    "                           edgelist=anomalous_edges[[\"src\", \"dst\"]].values,\n",
    "                           edge_color=\"red\", alpha=0.9, width=2)\n",
    "\n",
    "    axes[i].set_title(f\"Snapshot: {count} edges\\nAnomalies: {len(anomalous_edges)}\")\n",
    "    axes[i].axis(\"off\")\n",
    "\n",
    "plt.suptitle(\"📊 DARPA Graph Evolution — Normal (blue) vs Anomalous (red) Edges\", fontsize=18)\n",
    "plt.tight_layout(rect=[0, 0, 1, 0.93])\n",
    "plt.show()\n",
    "\n"
   ]
